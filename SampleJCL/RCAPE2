//RCAPE2 JOB (ACCT),'JAVA RCA PE2',
//************************************************************
//*
//* This job will run java created by RCA PE
//*
//* 1) Change the HLQ to your personal HLQ
//* 2) Change the MLQ to something appropriate for the test
//* 3) Add the source and reference files required for test
//*    This example has some Demo data sets included
//*
//************************************************************
//          NOTIFY=&SYSUID.,
//          CLASS=A,
//          MSGLEVEL=(1,1),
//          MSGCLASS=H
//*
//         EXPORT SYMLIST=(USER,MLQ)
//         SET USER=GTEST
//         SET HLQ=<userid>
//         SET MLQ=DEMO
//*
//         JCLLIB ORDER=AJV.V21R0M0.PROCLIB
//*
//JOBLIB   DD DISP=SHR,DSN=AJV.V21R0M0.SIEALNKE
//*
//*********************************************************************
//*   DELETE DATA SETS
//*********************************************************************
//*
//DELETE    EXEC PGM=IDCAMS
//*
//SYSPRINT  DD SYSOUT=*,DCB=(LRECL=133,BLKSIZE=12901,RECFM=FBA)
//*
//SYSIN     DD *,SYMBOLS=JCLONLY
 DELETE  GEBT.&USER..&MLQ..JAVAPE.LOG PURGE
 IF LASTCC > 0  THEN        /* IF OPERATION FAILED,     */    -
     SET MAXCC = 0          /* PROCEED AS NORMAL ANYWAY */
 DELETE  GEBT.&USER..&MLQ..JAVAPE.EXT1 PURGE
 IF LASTCC > 0  THEN        /* IF OPERATION FAILED,     */    -
     SET MAXCC = 0          /* PROCEED AS NORMAL ANYWAY */
 DELETE  GEBT.&USER..&MLQ..JAVAPE.SXT1 PURGE
 IF LASTCC > 0  THEN        /* IF OPERATION FAILED,     */    -
     SET MAXCC = 0          /* PROCEED AS NORMAL ANYWAY */
 DELETE  GEBT.&USER..&MLQ..SYSMDUMP PURGE
 IF LASTCC > 0  THEN        /* IF OPERATION FAILED,     */    -
     SET MAXCC = 0          /* PROCEED AS NORMAL ANYWAY */
