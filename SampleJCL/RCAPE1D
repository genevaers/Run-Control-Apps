//JAVA EXEC PROC=JVMPRC21,
// JAVACLS='org.genevaers.rcapps.Runner'
//STDENV DD *
. /etc/profile
export JAVA_HOME=/Java/J21.0_64
export IBM_JAVA_OPTIONS="-Dfile.encoding=ISO8859-1"
export APP_HOME=/u/<userid>/git/public/RCA_jar <-- $GERS_RCA_JAR_DIR
export APP_NAME=rcapps-latest.jar
export CLASSPATH=$APP_HOME:"$JAVA_HOME"/lib
LIBPATH=/lib:/usr/lib:"$JAVA_HOME"/bin
LIBPATH="$LIBPATH":"$JAVA_HOME"/lib
LIBPATH="$LIBPATH":"$JAVA_HOME"/lib/j9vm
export LIBPATH="$LIBPATH":
CLASSPATH="$CLASSPATH":"$APP_HOME"/"$APP_NAME"
echo $CLASSPATH
export CLASSPATH="$CLASSPATH":

# Configure JVM options
#   -Xms sets the minimum heap size
#   -Xmx sets the maximum heap size
#   You can increase these values if you are encountering memory problems.
IJO="-Xms16m -Xmx512m"
# Uncomment the following to aid in debugging "Class Not Found" problems
#IJO="$IJO -verbose:class"
IJO="$IJO -Dfile.encoding=ISO8859-1"
export IBM_JAVA_OPTIONS="$IJO "
//       DD DISP=SHR,DSN=<userid>.JINFO      <-- for db2 logon
//*
//*        INPUTS
//*
//RCAPARM DD *
# Input
GENERATE_RC_FILES=Y
GENERATE_PE_CODE=Y
INPUT_TYPE=DB2
DB_SERVER=xxx.yyy.com
DB_PORT=nnnn
DB_DATABASE=abc
DB_SCHEMA=SAFRxxx
ENVIRONMENT_ID=806
#
# Reports required
#
XLT_REPORT=N
JLT_REPORT=N
VDP_REPORT=N
REPORT_FORMAT=TEXT
COVERAGE=Y
RCA_REPORT=N
LOG_LEVEL=DEBUG
PE_CODE_DIR=PEJAVA
//*
//DBVIEWS DD *
# view numbers
12276

//*
//*        OUTPUT FILES
//*
//RCARPT  DD SYSOUT=*,DCB=(RECFM=VB,LRECL=255)
//RCALOG  DD SYSOUT=*,DCB=(RECFM=VB,LRECL=255)
//VDPNEW   DD DSN=GEBT.&USER..&MLQ..GRCA.VDP,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,
//            SPACE=(CYL,(100,50),RLSE),
//            DCB=(DSORG=PS,RECFM=VB,LRECL=8192,BLKSIZE=0)
