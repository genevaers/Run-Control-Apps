//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,
//            SPACE=(TRK,(10,50),RLSE),
//            DCB=(DSORG=PS,RECFM=VB,LRECL=150)
//JLTRPT   DD DSN=GEBT.&USER..&MLQ..GRCA.JLTRPT,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,
//            SPACE=(TRK,(10,50),RLSE),
//            DCB=(DSORG=PS,RECFM=VB,LRECL=150)
//VDPRPT   DD DSN=GEBT.&USER..&MLQ..GRCA.VDPRPT,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,
//            SPACE=(TRK,(10,50),RLSE),
//            DCB=(DSORG=PS,RECFM=VB,LRECL=150)
//*PEJAVA  DD SYSOUT=*,DCB=(RECFM=VB,LRECL=255)
//PEJAVA  DD PATH='/u/<userid>/PEJAVA/PECode.java',
//     PATHOPTS=(ORDWR,OCREAT,OTRUNC),PATHMODE=(SIRWXU,SIRWXG,SIROTH)
