//RCAPE1 JOB (ACCT),'JAVA RCA PE1',
//************************************************************
//*
//* This job will create PECode.java using RCA java
//*
//* This job reads from Workbench Db2
//*
//* 1) Change the HLQ to your personal HLQ
//* 2) Change the MLQ to something appropriate for the test
//* 3) Check the RCAPARM and DBVIEWS are pointing to
//*    correct Db2 and view
//* 4) Check you are pointing to the correct RCA build path
//*    in STDENV 
//* 5) Set logon details for Db2 in the JINFO data set  
//* 6) Check PEJAVA references /u/<tso-userid>/PEJAVA/PECode.java 
//*
//************************************************************
//          NOTIFY=&SYSUID.,
//          CLASS=A,
//          MSGLEVEL=(1,1),
//          MSGCLASS=H
//*
//         EXPORT SYMLIST=(USER,MLQ)
//         SET USER=GTEST
//         SET MLQ=DEMO.JAVAPE
//*
//         JCLLIB ORDER=AJV.V21R0M0.PROCLIB
//*
//JOBLIB   DD DISP=SHR,DSN=AJV.V21R0M0.SIEALNKE
//*
//*********************************************************************
//*   DELETE DATA SETS
//*********************************************************************
//*
//DELETE    EXEC PGM=IDCAMS
//*
//SYSPRINT  DD SYSOUT=*,DCB=(LRECL=133,BLKSIZE=12901,RECFM=FBA)
//*
//SYSIN     DD *,SYMBOLS=JCLONLY
 DELETE  GEBT.&USER..&MLQ..GRCA.VDPRPT PURGE
 IF LASTCC > 0  THEN        /* IF OPERATION FAILED,     */    -
     SET MAXCC = 0          /* PROCEED AS NORMAL ANYWAY */
 DELETE  GEBT.&USER..&MLQ..GRCA.XLTRPT PURGE
 IF LASTCC > 0  THEN        /* IF OPERATION FAILED,     */    -
     SET MAXCC = 0          /* PROCEED AS NORMAL ANYWAY */
 DELETE  GEBT.&USER..&MLQ..GRCA.JLTRPT PURGE
 IF LASTCC > 0  THEN        /* IF OPERATION FAILED,     */    -
     SET MAXCC = 0          /* PROCEED AS NORMAL ANYWAY */
 DELETE  GEBT.&USER..&MLQ..GRCA.VDP PURGE
 IF LASTCC > 0  THEN        /* IF OPERATION FAILED,     */    -
     SET MAXCC = 0          /* PROCEED AS NORMAL ANYWAY */
 DELETE  GEBT.&USER..&MLQ..GRCA.XLT PURGE
 IF LASTCC > 0  THEN        /* IF OPERATION FAILED,     */    -
     SET MAXCC = 0          /* PROCEED AS NORMAL ANYWAY */
 DELETE  GEBT.&USER..&MLQ..GRCA.JLT PURGE
 IF LASTCC > 0  THEN        /* IF OPERATION FAILED,     */    -
     SET MAXCC = 0          /* PROCEED AS NORMAL ANYWAY */
